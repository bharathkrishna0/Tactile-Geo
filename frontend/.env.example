# Public build-time setting. Vite inlines VITE_* values into the browser bundle,
# so this must only ever hold a URL, never a key.
#
# Leave empty for local development (Vite proxies /api to localhost:8000).
# On Vercel, set it to the backend origin, e.g. https://tactilegeo-api.onrender.com
VITE_API_BASE_URL=
