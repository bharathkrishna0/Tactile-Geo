# Model B is reached over HTTPS through OpenRouter's OpenAI-compatible API,
# using only the Python standard library. There is no provider SDK to install
# and no Google AI SDK anywhere in the dependency tree.
#
# This file is documentation. Nothing loads it automatically. Export the
# variables in the shell that starts the backend, e.g.
#
#   MODEL_B_ENABLED=true OPENROUTER_API_KEY=... uvicorn app.main:app --reload
#
# ---------------------------------------------------------------- Model A ---
# Model A is the deterministic pipeline and needs none of the variables below.
# Every one of them is optional, and Model A works with this file entirely empty.

# ---------------------------------------------------------------- Model B ---

# Master switch. Model B is off unless this is explicitly true.
MODEL_B_ENABLED=false

# REQUIRED to enable Model B. Server-side only.
#
# Never put a real key in this file, in any file committed to the repository, or
# in any VITE_* variable. Vite inlines VITE_* values into the shipped browser
# bundle, which would publish the key to anyone who loads the page.
#
# A backend test fails the build if a credential literal or a Vite-exposed key
# read appears anywhere under frontend/src.
OPENROUTER_API_KEY=

# Model identifier sent to OpenRouter. A router, not a model:
#   OPENROUTER_MODEL=openrouter/free
# The free router accepts images but may serve a different upstream per request,
# so the model that actually ran is recorded on every result rather than assumed.
#
# Pin a specific free vision-language model for reproducible output:
#   OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_MODEL=openrouter/free

# Gateway base URL. Change only for a self-hosted or proxied gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers. Public identifiers used for
# OpenRouter's request dashboard; not credentials.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=TactileGeo

# Per-attempt timeout in seconds. Kept short so a teacher sees a failure rather
# than a spinner.
MODEL_B_TIMEOUT_S=30

# Bounded retry. Applies only to transient failures (429 and 5xx). A 401, 403 or
# 404 is a configuration problem and is never retried.
MODEL_B_MAX_ATTEMPTS=3
MODEL_B_RETRY_BASE_DELAY_S=0.8
MODEL_B_RETRY_MAX_DELAY_S=5

# In-flight Model B jobs across the whole process.
MODEL_B_MAX_CONCURRENT_JOBS=4

# Development only. When true, a Model B run captures a redacted summary of the
# request and the provider's raw response, including the model's own words, so a
# rejected response can be inspected. Off by default; capture costs nothing when
# off.
#
# Redaction is unconditional and not gated on this flag: the API key, the
# Authorization header value, and the uploaded image are never captured. Set this
# only while debugging a live provider response, and never in production.
#
#   MODEL_B_DIAGNOSTICS=1 python scripts/model_b_live_smoke.py
MODEL_B_DIAGNOSTICS=false
